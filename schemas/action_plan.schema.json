{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailActionPlan",
  "type": "object",
  "required": [
    "email_id",
    "email_language",
    "category_primary",
    "gtd_bucket",
    "priority",
    "proposed_solution",
    "reply_options",
    "calendar_candidates",
    "asana_candidates",
    "bundle_hints",
    "risk_flags"
  ],
  "properties": {
    "email_id": {"type": "string"},
    "email_language": {"type": "string"},
    "category_primary": {
      "enum": [
        "Teaching/Students",
        "Teaching/Admin",
        "Writing/Research",
        "Collaboration/External",
        "Administration/Org",
        "Newsletter/Info",
        "Other/Unclassified"
      ]
    },
    "gtd_bucket": {
      "enum": ["Calendar", "Action", "Waiting For", "Reference", "Someday/Maybe"]
    },
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "proposed_solution": {
      "type": "object",
      "required": ["plan", "rationale", "confidence"],
      "properties": {
        "plan": {"type": "string"},
        "rationale": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "reply_options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "body"],
        "properties": {
          "label": {"type": "string"},
          "body": {"type": "string"}
        }
      }
    },
    "calendar_candidates": {"type": "array", "items": {"type": "object"}},
    "asana_candidates": {"type": "array", "items": {"type": "object"}},
    "bundle_hints": {"type": "array", "items": {"type": "string"}},
    "risk_flags": {"type": "array", "items": {"type": "string"}}
  }
}
